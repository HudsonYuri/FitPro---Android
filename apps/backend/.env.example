# Fonte dos exercícios:
#   exercisedb-free  API gratuita da ExerciseDB/AscendAPI (padrão, sem chave, GIFs 180p,
#                    uso não comercial segundo o fornecedor — confirme antes de publicar)
#   rapidapi         plano pago da ExerciseDB na RapidAPI (exige EXERCISEDB_API_KEY)
EXERCISE_SOURCE=exercisedb-free

# Só para EXERCISE_SOURCE=rapidapi. A chave nunca vai para o app.
EXERCISEDB_API_KEY=
EXERCISEDB_HOST=exercisedb.p.rapidapi.com

PORT=8787
# URL pública deste backend (usada nos links de GIF da RapidAPI).
# No emulador Android: http://10.0.2.2:8787
PUBLIC_BASE_URL=http://10.0.2.2:8787

# Onde guardar o catálogo baixado (evita baixar tudo de novo a cada restart).
CATALOG_CACHE_FILE=.cache/catalog.json
